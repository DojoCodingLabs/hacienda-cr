{
  "name": "@dojocoding/hacienda-sdk",
  "version": "0.4.0",
  "description": "Core SDK for Costa Rica electronic invoicing (Hacienda API v4.4)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "MIGRATION-v4.4.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "costa-rica",
    "hacienda",
    "electronic-invoicing",
    "factura-electronica",
    "comprobantes-electronicos"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dojocoding/hacienda-shared": "workspace:*",
    "@xmldom/xmldom": "^0.9.12",
    "fast-xml-parser": "^5.11.2",
    "node-forge": "^1.4.0",
    "smol-toml": "^1.9.0",
    "xadesjs": "^2.6.8",
    "xmldsigjs": "^2.8.8",
    "xmllint-wasm": "^5.3.0",
    "xpath": "^0.0.34",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14"
  },
  "license": "MIT",
  "author": "Dojo Coding Labs <dev@dojocoding.io> (https://dojocoding.io)",
  "repository": {
    "type": "git",
    "url": "https://github.com/DojoCodingLabs/hacienda-cr.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/DojoCodingLabs/hacienda-cr#readme",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
