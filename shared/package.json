{
  "name": "@dojocoding/hacienda-shared",
  "version": "0.4.0",
  "description": "Shared types, constants, and enums for Hacienda CR electronic invoicing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "costa-rica",
    "hacienda",
    "electronic-invoicing",
    "factura-electronica",
    "comprobantes-electronicos"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "license": "MIT",
  "author": "Dojo Coding Labs <dev@dojocoding.io> (https://dojocoding.io)",
  "repository": {
    "type": "git",
    "url": "https://github.com/DojoCodingLabs/hacienda-cr.git",
    "directory": "shared"
  },
  "homepage": "https://github.com/DojoCodingLabs/hacienda-cr#readme",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
