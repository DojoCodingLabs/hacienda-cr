  },
  "homepage": "https://github.com/DojoCodingLabs/hacienda-cr#readme",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/release.mjs publish",
    "prepare": "husky",
    "test:packages": "node scripts/verify-packages.mjs",
    "verify": "node scripts/verify.mjs",
    "spec:verify": "node scripts/spec-verify.mjs",
    "holidays:watch": "node scripts/holidays-watch.mjs",
    "spec:check": "node scripts/spec-watch/check.mjs",
    "spec:update": "node scripts/spec-watch/update.mjs",
    "test:scripts": "node scripts/run-script-tests.mjs",
    "test:properties": "node scripts/run-properties-tests.mjs",
    "test:mutation": "node scripts/run-mutation-tests.mjs",
    "test:coverage": "turbo run test:coverage",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish",
    "test:sandbox": "node scripts/sandbox-lifecycle.mjs",
    "codes:extract": "node scripts/codes-extract/extract.mjs",
    "spec:generate": "node scripts/codes-generate/generate.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "^10.15.0",
    "exceljs": "^4.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "node-unrar-js": "^2.0.2",
    "prettier": "^3.10.1",
    "tar": "^7.5.23",
    "tsup": "^9.0.0",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
